    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "test:e2e": "playwright test",
    "test:e2e:all": "FULL_E2E=1 playwright test",
    "test:e2e:build": "npm run build:web && playwright test",
    "profile:library": "node scripts/profile-library.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-community/netinfo": "12.0.1",
